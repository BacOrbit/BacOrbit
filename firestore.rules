rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    /* ── admins/{uid} ── مصدر الصلاحية الحقيقي. لا يُنشأ ولا يُعدَّل
       إلا يدويًا من Firebase Console (انظر ADMIN_SETUP_README.md). */
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    /* ── users/{uid} ── حساب كل تلميذ (مجهول الهوية). */
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isAdmin() || (isOwner(uid) && onlyChanged(['name']));
      allow delete: if false;
    }

    /* ── forumPosts/{postId} ── منشورات وردود المنتدى. */
    match /forumPosts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && (
        (resource.data.uid == request.auth.uid && onlyChanged(['deleted'])) ||
        onlyChanged(['reportCount', 'reports', 'removed']) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    /* ── summaries/{id} ── الملخصات والملفات المرسلة من submit-summary.js
       و add-files.js على حد سواء (نفس المجموعة، نفس دورة المراجعة). */
    match /summaries/{id} {
      allow read: if isSignedIn() &&
        (resource.data.status == 'approved' ||
         resource.data.submitterUid == request.auth.uid ||
         isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.submitterUid == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isAdmin(); /* القبول/الرفض حصرًا من الإدارة */
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.submitterUid == request.auth.uid && resource.data.status == 'pending');
    }

    /* ── savedLessons/{id} ── ميزة "الدراسة لاحقًا". كل وثيقة تخص
       مستخدمًا واحدًا فقط، ومعرّفها المتفق عليه هو uid + '__' + مسار
       الصفحة (انظر study-later.js) — لا نسخ مكررة لنفس الدرس. */
    match /savedLessons/{id} {
      allow read, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid;
    }

    /* ── notifications/{id} ── إشعارات "الدراسة لاحقًا" (يُنشئها
       المستخدم لنفسه فقط) وإشعارات ردود المنتدى (ينشئها من ردّ
       لمستخدم آخر هو صاحب الموضوع، وليس لنفسه). لا حذف من العميل. */
    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        onlyChanged(['read']);
      allow create: if isSignedIn() && (
        (request.resource.data.type == 'study_reminder' &&
         request.resource.data.uid == request.auth.uid) ||
        (request.resource.data.type == 'forum_reply' &&
         request.resource.data.fromUid == request.auth.uid &&
         request.resource.data.uid != request.auth.uid)
      );
      allow delete: if false;
    }
  }
}
